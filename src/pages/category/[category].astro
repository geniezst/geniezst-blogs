---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import CategoryBar from '../../components/CategoryBar.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../../lib/db';
import type { BlogPost, Category } from '../../types/blog';

const { category: categorySlug } = Astro.params;
if (!categorySlug) {
  return Astro.redirect('/blog');
}

const db = await getDb(Astro.locals);
let posts: BlogPost[] = [];
let total = 0;
let totalAllPosts = 0;
let currentCategory: Category | undefined;
let categories: Category[] = [];

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit: 20, categorySlug }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = postsRes.total;
    totalAllPosts = totalCount;
    categories = categoriesRes;
    currentCategory = categories.find((c) => c.slug === categorySlug);
  } catch (err) {
    console.error('Failed to fetch category posts:', err);
  }
}

if (!currentCategory) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---

<BaseLayout
  title={`${currentCategory.name} - 포켓머니`}
  description={currentCategory.description || `${currentCategory.name} 관련 알뜰 금융 가이드 모음`}
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} totalPosts={totalAllPosts} />

    <div class="flex-1 w-full flex flex-col gap-4">
      <!-- Shirone CategoryBar (현재 카테고리 활성화) -->
      <CategoryBar categories={categories} currentCategory={categorySlug} totalPosts={totalAllPosts} />

      <!-- 카테고리 헤더 -->
      <div class="card-base p-5 sm:p-6">
        <div class="flex items-center justify-between gap-2 mb-2">
          <div class="flex items-center gap-2">
            <span class="w-1 h-4 rounded-full bg-[var(--primary)] shrink-0"></span>
            <span class="text-xs font-bold text-[var(--primary)] uppercase tracking-wider">
              카테고리 아카이브
            </span>
          </div>
          <span class="text-xs font-mono font-bold text-[var(--on-surface-variant)]">
            총 {total}편 등록
          </span>
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-[var(--on-surface)] font-heading">
          {currentCategory.name}
        </h1>
        {currentCategory.description && (
          <p class="mt-2 text-sm text-[var(--on-surface-variant)] leading-relaxed">
            {currentCategory.description}
          </p>
        )}
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-4">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card-base p-12 text-center">
          <p class="text-[var(--on-surface-variant)] text-sm">이 카테고리에는 아직 등록된 가이드가 없습니다.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
