---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getDb, getCategories } from '../lib/db';
import type { Category } from '../types/blog';

const db = await getDb(Astro.locals);
let categories: Category[] = [];
if (db) {
  categories = await getCategories(db);
}
---

<BaseLayout
  title="블로그 소개 - 포켓머니"
  description="포켓머니 운영자, 글 작성·검수 방식, 광고·정정 정책 안내입니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} />

    <div class="flex-1 w-full card-base p-6 sm:p-10">
      <h1 class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white mb-2">
        About 포켓머니
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 pb-4 border-b border-neutral-100 dark:border-neutral-800 mb-6">
        정부 지원 제도와 생활 금융 정보를 공식 자료 기준으로 정리하는 개인 블로그
      </p>

      <div class="prose prose-neutral dark:prose-invert max-w-none text-base leading-relaxed
                  prose-headings:font-bold prose-a:text-emerald-600 dark:prose-a:text-emerald-400">
        <p>
          <strong>포켓머니</strong>는 정부 지원금·복지 제도, 연말정산과 세금 공제, 예적금·대출 같은 생활 금융 정보를
          공식 발표 자료를 바탕으로 이해하기 쉽게 정리하는 개인 운영 블로그입니다.
        </p>

        <h2>다루는 분야</h2>
        <ul>
          <li><strong>정부 지원금·복지:</strong> 청년·신혼부부·출산 가구 등을 위한 지원 제도의 자격과 신청 방법</li>
          <li><strong>세금·연말정산:</strong> 소득공제·세액공제 구조, 근로장려금 등 신청 일정</li>
          <li><strong>저축·금융:</strong> 정책 적금, 청약통장, ISA 등 절세 계좌 제도</li>
          <li><strong>주거:</strong> 전세·월세 대출, 주거급여, 주택연금 등 주거 관련 제도</li>
          <li><strong>소상공인·생활 행정:</strong> 정책자금, 생활 속 행정 절차</li>
        </ul>

        <h2>운영자</h2>
        <p>
          포켓머니는 개인 1인이 운영합니다. 운영자는 금융회사, 세무사·회계사 등 전문 자격을 가진 기관이나 전문가가 아니며,
          본 사이트의 글은 금융·세무 자문이 아닌 일반 정보입니다. 법인이나 사업장 주소를 따로 두고 있지 않으며, 연락은 이메일로 받습니다.
        </p>

        <h2>글을 만드는 방식</h2>
        <p>독자가 글의 신뢰도를 스스로 판단할 수 있도록 작성 방식을 그대로 밝힙니다.</p>
        <ul>
          <li><strong>AI 보조 작성:</strong> 글 초안 작성에 AI(Google Gemini)를 사용합니다. 일부 글은 정해진 일정에 따라 자동으로 생성·게시됩니다.</li>
          <li><strong>공식 자료 대조:</strong> 운영자가 정부 부처·공공기관·운영 기관의 공고와 원문을 기준으로 금액·한도·금리·자격·기간을 확인하고 수정합니다. 자동으로 게시된 글은 게시 후에 이 확인을 거칠 수 있습니다.</li>
          <li><strong>확인되지 않는 내용:</strong> 공식 자료로 확인하지 못한 수치나 존재가 확인되지 않는 제도는 수정하거나 비공개 처리합니다. 발표만 되고 시행이 확정되지 않은 내용은 그렇게 구분해 적습니다.</li>
          <li><strong>기준일 표시:</strong> 제도와 금리는 자주 바뀌므로 글의 작성일·확인 기준일을 함께 보시고, 각 글 하단의 <strong>공식 확인처</strong>에서 최신 공고를 확인한 뒤 신청해 주세요.</li>
        </ul>

        <h2>광고와 제휴</h2>
        <p>
          사이트 운영비 마련을 위해 Google AdSense 광고를 게재하거나 준비하고 있습니다. 현재 수수료를 받는 제휴 링크는 없으며,
          도입하는 경우 해당 글에 표시합니다. 자세한 내용은 <a href="/terms">이용약관 및 면책 고지</a>와
          <a href="/privacy">개인정보처리방침</a>을 참고해 주세요.
        </p>

        <h2>오류 제보와 정정</h2>
        <p>
          본문의 오류나 바뀐 정책 정보를 발견하시면 아래 이메일로 알려주세요. 공식 자료와 대조해 확인한 뒤 본문을 고치고,
          수정한 내용은 글에 반영합니다.
        </p>
        <ul>
          <li><strong>문의/정정 요청:</strong> <a href="mailto:geniezst@gmail.com">geniezst@gmail.com</a></li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
