---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { getDb, getCategories } from '../lib/db';
import type { Category } from '../types/blog';

const db = await getDb(Astro.locals);
let categories: Category[] = [];
if (db) {
  categories = await getCategories(db);
}
---

<BaseLayout
  title="블로그 소개 - 포켓머니"
  description="포켓머니의 운영 철학과 생활 금융 가이드 소개입니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} />

    <div class="flex-1 w-full card-base p-6 sm:p-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800/40 mb-3">
        <span>🏛️</span>
        <span>스마트 금융 아카이브</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white mb-2">
        About 포켓머니
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 pb-4 border-b border-neutral-100 dark:border-neutral-800 mb-6">
        놓치면 손해보는 정부 복지 혜택과 알뜰 생활 금융의 모든 것
      </p>

      <div class="prose prose-neutral dark:prose-invert max-w-none text-base leading-relaxed
                  prose-headings:font-bold prose-a:text-emerald-600 dark:prose-a:text-emerald-400">
        <p>
          <strong>포켓머니</strong>는 복잡하고 어려운 정부 정책 지원금, 숨은 세금 환급금, 알뜰 금융 및 생활비 절약 노하우를 일반 독자의 눈높이에서 가장 쉽고 명쾌하게 안내하는 실전 생활 금융 가이드입니다.
        </p>

        <h2>주요 다루는 분야</h2>
        <ul>
          <li><strong>정부 지원금 &amp; 복지:</strong> 청년도약계좌, 근로·자녀장려금, 부모급여 등 전 국민 맞춤형 복지 혜택</li>
          <li><strong>연말정산 &amp; 절세/환급:</strong> 숨은 국세/지방세 환급금 조회, 소득공제 극대화 전략</li>
          <li><strong>예적금 &amp; 금융 팁:</strong> 고금리 파킹통장 실시간 비교, 특판 예적금, 청약통장 및 ISA 절세 계좌 활용법</li>
          <li><strong>생활비 절약 &amp; 공과금:</strong> 전기·가스요금 캐시백, 통신비 25% 요금할인, 신용·체크카드 피킹 노하우</li>
          <li><strong>소상공인 &amp; 정책자금:</strong> 소상공인 전기료 지원, 저금리 대환 대출, 희망리턴패키지 정부 지원금</li>
          <li><strong>생활 행정 &amp; 필수 팁:</strong> 정부24 원스톱 민원 서류 발급, 착한운전 마일리지, 일상 행정 상식</li>
        </ul>

        <h2>운영 원칙</h2>
        <p>
          모든 콘텐츠는 정부 부처와 금융기관의 공식 발표 자료 및 최신 법령을 기준으로 철저히 검증하여 작성되며,
          누구나 3분 안에 이해하고 모바일로 바로 신청할 수 있는 실천적 가이드를 지향합니다.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
