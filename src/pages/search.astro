---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getDb, getCategories } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

const q = (Astro.url.searchParams.get('q') || '').trim();
let results: BlogPost[] = [];
let categories: Category[] = [];

const db = await getDb(Astro.locals);
if (db) {
  categories = await getCategories(db);
  if (q) {
    try {
      const searchTerm = `%${q}%`;
      const query = `
        SELECT p.*, c.name as category_name, c.slug as category_slug
        FROM blog_posts p
        LEFT JOIN blog_categories c ON p.category_id = c.id
        WHERE p.status = 'published' AND (p.title LIKE ? OR p.description LIKE ? OR p.content LIKE ?)
        ORDER BY p.published_at DESC LIMIT 20
      `;
      const stmt = db.prepare(query).bind(searchTerm, searchTerm, searchTerm);
      const res = await stmt.all<BlogPost>();
      results = res.results ?? [];
    } catch (err) {
      console.error('Search failed:', err);
    }
  }
}
---

<BaseLayout
  title={q ? `'${q}' 검색 결과 - geniezst` : '글 검색 - geniezst'}
  description="geniezst 블로그의 글과 트러블슈팅 가이드를 검색합니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} />

    <div class="flex-1 w-full flex flex-col gap-6">
      <div class="fuwari-card p-6 sm:p-8">
        <h1 class="text-2xl font-black text-neutral-900 dark:text-white mb-4">
          글 검색
        </h1>

        <!-- 검색창 -->
        <form method="GET" action="/search">
          <div class="relative">
            <input
              type="search"
              name="q"
              value={q}
              placeholder="궁금한 기술, 에러 메시지, 제품명을 입력하세요..."
              required
              class="w-full px-4 py-3 pl-11 rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/80 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition"
            />
            <svg
              class="w-5 h-5 absolute left-3.5 top-3.5 text-neutral-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </form>
      </div>

      <!-- 검색 결과 -->
      {q ? (
        <div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 px-2 mb-4">
            <strong>'{q}'</strong> 검색 결과: 총 {results.length}건
          </p>

          {results.length > 0 ? (
            <div class="flex flex-col gap-5">
              {results.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <div class="fuwari-card p-12 text-center">
              <p class="text-sm text-neutral-500 dark:text-neutral-400">
                일치하는 글을 찾을 수 없습니다. 다른 키워드로 검색해 보세요.
              </p>
            </div>
          )}
        </div>
      ) : (
        <div class="fuwari-card p-12 text-center text-sm text-neutral-400 dark:text-neutral-500">
          검색어를 입력하고 Enter를 누르세요.
        </div>
      )}
    </div>
  </div>
</BaseLayout>
