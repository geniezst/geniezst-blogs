---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getDb, getCategories } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

const q = (Astro.url.searchParams.get('q') || '').trim();
let results: BlogPost[] = [];
let categories: Category[] = [];

const db = await getDb(Astro.locals);
if (db) {
  categories = await getCategories(db);
  if (q) {
    try {
      const searchTerm = `%${q}%`;
      const query = `
        SELECT p.*, c.name as category_name, c.slug as category_slug
        FROM blog_posts p
        LEFT JOIN blog_categories c ON p.category_id = c.id
        WHERE p.status = 'published' AND (p.title LIKE ? OR p.description LIKE ? OR p.content LIKE ?)
        ORDER BY p.published_at DESC LIMIT 20
      `;
      const stmt = db.prepare(query).bind(searchTerm, searchTerm, searchTerm);
      const res = await stmt.all<BlogPost>();
      results = res.results ?? [];
    } catch (err) {
      console.error('Search failed:', err);
    }
  }
}
---

<BaseLayout
  title={q ? `'${q}' 검색 결과 - 스마트 라이프 & 머니` : '가이드 검색 - 스마트 라이프 & 머니'}
  description="정부 지원금, 환급금, 예적금, 생활 절세 가이드를 검색합니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} />

    <div class="flex-1 w-full flex flex-col gap-6">
      <div class="card-base p-6 sm:p-8 border-emerald-100/80 dark:border-emerald-950/50">
        <h1 class="text-2xl font-black text-neutral-900 dark:text-white mb-2">
          생활 금융 가이드 검색
        </h1>
        <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 mb-4">
          궁금한 정책 지원금, 환급금, 공과금 절약 키워드를 검색하세요.
        </p>

        <!-- 검색창 -->
        <form method="GET" action="/search">
          <div class="relative">
            <input
              type="search"
              name="q"
              value={q}
              placeholder="지원금 명칭, 환급, 세금, 청년, 소상공인 등 입력..."
              required
              class="w-full px-4 py-3 pl-11 rounded-2xl border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-slate-800/80 text-neutral-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm transition"
            />
            <svg
              class="w-5 h-5 absolute left-3.5 top-3.5 text-emerald-600 dark:text-emerald-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </form>
      </div>

      <!-- 검색 결과 -->
      {q ? (
        <div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 px-2 mb-4">
            <strong class="text-emerald-700 dark:text-emerald-400">'{q}'</strong> 검색 결과: 총 {results.length}건
          </p>

          {results.length > 0 ? (
            <div class="flex flex-col gap-5">
              {results.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <div class="card-base p-12 text-center border-emerald-100/60 dark:border-emerald-950/40">
              <p class="text-sm text-neutral-500 dark:text-neutral-400">
                일치하는 글을 찾을 수 없습니다. 다른 키워드로 검색해 보세요.
              </p>
            </div>
          )}
        </div>
      ) : (
        <div class="card-base p-12 text-center text-sm text-neutral-400 dark:text-neutral-500 border-emerald-100/60 dark:border-emerald-950/40">
          검색어를 입력하고 Enter를 누르세요.
        </div>
      )}
    </div>
  </div>
</BaseLayout>
