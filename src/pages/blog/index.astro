---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import CategoryBar from '../../components/CategoryBar.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../../lib/db';
import type { BlogPost, Category } from '../../types/blog';

const page = Number(Astro.url.searchParams.get('page') || '1');
const limit = 10;
const offset = (page - 1) * limit;

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit, offset }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = totalCount > 0 ? totalCount : postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch posts:', err);
  }
}

const totalPages = Math.ceil(total / limit);
---

<BaseLayout
  title="전체 가이드 목록 - 스마트 라이프 & 머니"
  description="놓치면 손해보는 정부 지원금, 환급금, 예적금, 생활 절세 가이드 전체 목록입니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <Sidebar categories={categories} totalPosts={total} />

    <div class="flex-1 w-full flex flex-col gap-4">
      <!-- Shirone CategoryBar (가로 스크롤 카테고리 칩 바) -->
      <CategoryBar categories={categories} totalPosts={total} />

      <!-- 헤더 -->
      <div class="flex items-center justify-between px-1">
        <h1 class="text-base font-bold text-[var(--on-surface)] flex items-center gap-2 font-heading">
          <span class="w-1 h-4 rounded-full bg-[var(--primary)]"></span>
          <span>전체 가이드 ({total})</span>
        </h1>
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-4">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card-base p-12 text-center">
          <p class="text-[var(--on-surface-variant)] text-sm">아직 등록된 가이드가 없습니다.</p>
        </div>
      )}

      <!-- 페이지네이션 -->
      {totalPages > 1 && (
        <div class="card-base p-4 flex items-center justify-center gap-3 text-xs font-medium">
          {page > 1 && (
            <a
              href={`/blog?page=${page - 1}`}
              class="px-3.5 py-1.5 rounded-xl bg-[var(--surface-container-low)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)] hover:text-[var(--primary)] transition"
            >
              &larr; 이전
            </a>
          )}
          <span class="text-[var(--on-surface-variant)] font-mono">
            {page} / {totalPages}
          </span>
          {page < totalPages && (
            <a
              href={`/blog?page=${page + 1}`}
              class="px-3.5 py-1.5 rounded-xl bg-[var(--surface-container-low)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)] hover:text-[var(--primary)] transition"
            >
              다음 &rarr;
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
