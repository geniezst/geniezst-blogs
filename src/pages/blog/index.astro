---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../../lib/db';
import type { BlogPost, Category } from '../../types/blog';

const page = Number(Astro.url.searchParams.get('page') || '1');
const limit = 10;
const offset = (page - 1) * limit;

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit, offset }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = totalCount > 0 ? totalCount : postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch posts:', err);
  }
}

const totalPages = Math.ceil(total / limit);
---

<BaseLayout
  title="전체 가이드 목록 - 스마트 라이프 & 머니"
  description="놓치면 손해보는 정부 지원금, 환급금, 예적금, 생활 절세 가이드 전체 목록입니다."
>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <Sidebar categories={categories} totalPosts={total} />

    <div class="flex-1 w-full flex flex-col gap-6">
      <div class="card-base p-6 sm:p-8 bg-gradient-to-r from-pink-500/10 via-purple-500/5 to-transparent">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--primary)] uppercase tracking-wider mb-2">
          <span>📚</span>
          <span>생활 금융 공식 아카이브</span>
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white font-heading">
          생활 금융 전체 가이드
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
          총 {total}개의 실전 혜택 및 지원금 가이드가 등록되어 있습니다.
        </p>

        <!-- 카테고리 칩 -->
        {categories.length > 0 && (
          <div class="mt-5 pt-4 border-t border-neutral-200/70 dark:border-neutral-800 flex flex-wrap gap-2">
            <a
              href="/blog"
              class="px-3 py-1.5 rounded-xl text-xs font-bold bg-[var(--primary)] text-white shadow-xs scale-animation"
            >
              전체 보기 ({total})
            </a>
            {categories.map((c) => (
              <a
                href={`/category/${c.slug}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium bg-neutral-100 dark:bg-slate-800 text-neutral-700 dark:text-neutral-300 hover:bg-pink-50 dark:hover:bg-pink-950/40 hover:text-[var(--primary)] transition scale-animation"
              >
                <span>{c.name}</span>
                {c.post_count !== undefined && c.post_count > 0 && (
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded-full bg-pink-100 dark:bg-pink-950 text-pink-800 dark:text-pink-300">
                    {c.post_count}
                  </span>
                )}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-4">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card-base p-12 text-center">
          <p class="text-neutral-500 dark:text-neutral-400 text-sm">아직 등록된 가이드가 없습니다.</p>
        </div>
      )}

      <!-- 페이지네이션 -->
      {totalPages > 1 && (
        <div class="card-base p-4 flex items-center justify-center gap-3 text-xs font-medium">
          {page > 1 && (
            <a
              href={`/blog?page=${page - 1}`}
              class="px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-slate-800 hover:text-emerald-600 transition"
            >
              &larr; 이전
            </a>
          )}
          <span class="text-neutral-500 font-mono">
            {page} / {totalPages}
          </span>
          {page < totalPages && (
            <a
              href={`/blog?page=${page + 1}`}
              class="px-3.5 py-1.5 rounded-xl bg-neutral-100 dark:bg-slate-800 hover:text-emerald-600 transition"
            >
              다음 &rarr;
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
