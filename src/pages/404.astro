---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';

Astro.response.status = 404;
---

<BaseLayout
  title={`404 - 페이지를 찾을 수 없습니다 | ${siteConfig.title}`}
  description="요청하신 페이지가 존재하지 않거나 이동되었습니다."
>
  <div class="max-w-2xl mx-auto py-16 text-center">
    <div class="card-base p-10 sm:p-14">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 font-black text-2xl mb-6 border border-emerald-200/50 dark:border-emerald-900/40">
        404
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white mb-3">
        페이지를 찾을 수 없습니다
      </h1>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed mb-8">
        요청하신 주소의 금융/지원금 정보 페이지가 삭제되었거나, 주소가 변경되었거나, 일시적으로 사용할 수 없습니다.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="/"
          class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 transition shadow-sm"
        >
          홈으로 이동
        </a>
        <a
          href="/blog"
          class="px-5 py-2.5 rounded-xl text-sm font-semibold text-neutral-700 dark:text-neutral-300 bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition"
        >
          전체 글 목록
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
