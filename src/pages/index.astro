---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit: 10 }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = totalCount > 0 ? totalCount : postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch from D1:', err);
  }
}
---

<BaseLayout
  title="스마트 라이프 & 머니 - 놓치면 손해보는 정부 혜택과 알뜰 금융 가이드"
  description="청년·서민·직장인 필수 정부 지원금, 숨은 세금 환급금 조회, 고금리 파킹통장 비교 및 생활비 절약 실전 노하우를 가장 정확하고 알기 쉽게 전해드립니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <!-- 사이드바 (Fumika 시그니처: 프로필 + 카테고리) -->
    <Sidebar categories={categories} totalPosts={total} />

    <!-- 메인 컨텐츠 영역 -->
    <div class="flex-1 w-full flex flex-col gap-6">
      <!-- 상단 웰컴 배너 카드 (모바일에서는 숨김, 데스크톱 lg에서만 표시) -->
      <div class="hidden lg:block card-base p-6 sm:p-8 bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-transparent border-emerald-200/40 dark:border-emerald-900/30">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-600 text-white shadow-xs mb-3">
          스마트 라이프 &amp; 머니
        </span>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-900 dark:text-white leading-tight font-heading">
          놓치기 쉬운 정부 지원금 &amp; 생활 금융 가이드
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
          청년·서민·직장인 필수 정부 지원금, 숨은 세금 환급금 조회, 고금리 파킹통장 비교 및 실전 생활비 절약 노하우를 가장 정확하고 알기 쉽게 전해드립니다.
        </p>
      </div>

      <!-- 광고 슬롯 -->
      <AdSlot format="horizontal" />

      <!-- 최신 가이드 헤더 -->
      <div class="flex items-center justify-between px-2">
        <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 flex items-center gap-2 font-heading">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span>최신 정책 가이드 (Recent Posts)</span>
        </h2>
        <a href="/blog" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
          전체 보기 ({total}) &rarr;
        </a>
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-5">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card-base p-12 text-center">
          <p class="text-neutral-500 dark:text-neutral-400 text-sm">등록된 가이드가 준비 중입니다.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
