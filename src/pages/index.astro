---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDb, getPublishedPosts, getCategories } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes] = await Promise.all([
      getPublishedPosts(db, { limit: 10 }),
      getCategories(db),
    ]);
    posts = postsRes.posts;
    total = postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch from D1:', err);
  }
}
---

<BaseLayout
  title="geniezst - 실사용 기반 IT & AI 테크 블로그"
  description="NAS, Docker, Cloudflare, Mac, Windows, AI 활용법 등 실무 경험과 문제 해결 노하우를 공유합니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <!-- 사이드바 (Fuwari 시그니처: 프로필 + 카테고리) -->
    <Sidebar categories={categories} totalPosts={total} />

    <!-- 메인 컨텐츠 영역 -->
    <div class="flex-1 w-full flex flex-col gap-6">
      <!-- 상단 웰컴 배너 카드 -->
      <div class="fuwari-card p-6 sm:p-8 bg-gradient-to-br from-blue-500/10 via-indigo-500/5 to-purple-500/10 border-blue-200/40 dark:border-blue-900/30">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-blue-600 text-white shadow-xs mb-3">
          Tech &amp; Troubleshooting Archive
        </span>
        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-900 dark:text-white leading-tight">
          실제 경험과 문제 해결을 위한 테크 블로그
        </h1>
        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
          NAS 홈랩, Docker 컨테이너 분리, Cloudflare 서버리스 엣지, Apple 생태계 최적화부터 AI 파이프라인까지 직접 검증한 해결책과 가이드를 공유합니다.
        </p>
      </div>

      <!-- 광고 슬롯 -->
      <AdSlot format="horizontal" />

      <!-- 최신 글 리스트 헤더 -->
      <div class="flex items-center justify-between px-2">
        <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
          <span>최신 글 (Recent Posts)</span>
        </h2>
        <a href="/blog" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline">
          전체 보기 &rarr;
        </a>
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-5">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="fuwari-card p-12 text-center">
          <p class="text-neutral-500 dark:text-neutral-400 text-sm">아직 등록된 포스트가 없습니다.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
