---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import CategoryBar from '../components/CategoryBar.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit: 10 }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = totalCount > 0 ? totalCount : postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch from D1:', err);
  }
}
---

<BaseLayout
  title="스마트 라이프 & 머니 - 놓치면 손해보는 정부 혜택과 알뜰 금융 가이드"
  description="청년·서민·직장인 필수 정부 지원금, 숨은 세금 환급금 조회, 고금리 파킹통장 비교 및 생활비 절약 실전 노하우를 가장 정확하고 알기 쉽게 전해드립니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <!-- 사이드바 (Shirone 프로필 + 카테고리) -->
    <Sidebar categories={categories} totalPosts={total} />

    <!-- 메인 컨텐츠 영역 -->
    <div class="flex-1 w-full flex flex-col gap-4">
      <!-- Shirone CategoryBar (가로 스크롤 카테고리 칩 바) -->
      <CategoryBar categories={categories} totalPosts={total} />

      <!-- 최신 가이드 헤더 -->
      <div class="flex items-center justify-between px-1">
        <h2 class="text-base font-bold text-[var(--on-surface)] flex items-center gap-2 font-heading">
          <span class="w-1 h-4 rounded-full bg-[var(--primary)]"></span>
          <span>최신 정책 가이드</span>
        </h2>
        <a href="/blog" class="text-xs font-semibold text-[var(--primary)] hover:underline">
          전체 보기 ({total}) &rarr;
        </a>
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-4">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="card-base p-12 text-center">
          <p class="text-[var(--on-surface-variant)] text-sm">등록된 가이드가 준비 중입니다.</p>
        </div>
      )}

      <!-- 광고 슬롯 -->
      <AdSlot format="horizontal" />
    </div>
  </div>
</BaseLayout>
