---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDb, getPublishedPosts, getCategories } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes] = await Promise.all([
      getPublishedPosts(db, { limit: 10 }),
      getCategories(db),
    ]);
    posts = postsRes.posts;
    total = postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch from D1:', err);
  }
}

const categoryQuickPills = [
  { slug: 'welfare', name: '정부 지원금', icon: '🏛️' },
  { slug: 'tax', name: '연말정산·환급', icon: '💰' },
  { slug: 'finance', name: '예적금·금융', icon: '📈' },
  { slug: 'saving', name: '생활비 절약', icon: '⚡' },
  { slug: 'subsidy', name: '소상공인', icon: '🏪' },
  { slug: 'life-tips', name: '생활 행정', icon: '📋' },
];
---

<BaseLayout
  title="스마트 라이프 & 머니 - 놓치면 손해보는 정부 혜택과 알뜰 금융 가이드"
  description="청년·서민·직장인 정부 지원금, 숨은 세금 환급금 조회, 고금리 파킹통장 및 생활비 절약 노하우를 알기 쉽게 정리합니다."
>
  <div class="flex flex-col lg:flex-row gap-6 items-start">
    <!-- 사이드바 (스마트 머니 프로필 + 카테고리) -->
    <Sidebar categories={categories} totalPosts={total} />

    <!-- 메인 컨텐츠 영역 -->
    <div class="flex-1 w-full flex flex-col gap-6">
      <!-- 상단 웰컴 배너 카드 (매거진 핀테크 스타일) -->
      <div class="fuwari-card p-6 sm:p-8 bg-gradient-to-br from-emerald-500/12 via-teal-500/6 to-emerald-500/4 border-emerald-200/60 dark:border-emerald-900/40 relative overflow-hidden">
        <div class="absolute -right-6 -bottom-6 opacity-10 dark:opacity-5 pointer-events-none">
          <svg class="w-48 h-48 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.41 16.09V20h-2.67v-1.93c-1.71-.36-3.16-1.46-3.27-3.4h1.96c.1 1.05.82 1.87 2.65 1.87 1.96 0 2.4-.98 2.4-1.59 0-.83-.44-1.61-2.67-2.14-2.48-.6-4.18-1.62-4.18-3.67 0-1.72 1.39-2.84 3.11-3.21V4h2.67v1.95c1.86.45 2.79 1.86 2.85 3.12h-2c-.08-.79-.65-1.56-2.19-1.56-1.54 0-2.2.78-2.2 1.48 0 .81.56 1.4 2.68 1.94 2.59.66 4.19 1.63 4.19 3.82 0 1.64-1.25 2.89-3.08 3.34z"/>
          </svg>
        </div>

        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-600 text-white shadow-xs mb-3">
          <span>🏛️</span>
          <span>대한민국 복지 &amp; 알뜰 금융 가이드</span>
        </span>

        <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-neutral-900 dark:text-white leading-tight">
          내 지갑을 지키는 가장 스마트한 생활 금융 습관
        </h1>

        <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
          청년·서민·직장인 필수 정부 지원금, 숨은 연말정산 환급금 조회, 고금리 파킹통장 비교 및 실전 생활비 절약 노하우를 가장 정확하고 알기 쉽게 전해드립니다.
        </p>

        <!-- 3대 안심 포인트 칩 -->
        <div class="mt-5 pt-4 border-t border-emerald-200/50 dark:border-emerald-900/40 flex flex-wrap gap-2 sm:gap-3 text-xs">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/80 dark:bg-slate-900/60 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/50 dark:border-emerald-800/40">
            ✓ 100% 공식 정책 기준 검증
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/80 dark:bg-slate-900/60 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/50 dark:border-emerald-800/40">
            ✓ 모바일 3분 비대면 신청 경로
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-white/80 dark:bg-slate-900/60 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/50 dark:border-emerald-800/40">
            ✓ 놓치기 쉬운 불이익 예방 가이드
          </span>
        </div>
      </div>

      <!-- 카테고리 퀵 필터 칩 바 -->
      <div class="fuwari-card p-3 sm:p-4 border-emerald-100/70 dark:border-emerald-950/40 flex items-center gap-2 overflow-x-auto scrollbar-none">
        <a
          href="/blog"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shrink-0 hover:bg-emerald-700 transition"
        >
          전체 보기
        </a>
        {categoryQuickPills.map((pill) => (
          <a
            href={`/category/${pill.slug}`}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-neutral-100 dark:bg-slate-800/70 text-neutral-700 dark:text-neutral-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-700 dark:hover:text-emerald-300 border border-neutral-200/60 dark:border-neutral-700/60 shrink-0 transition"
          >
            <span>{pill.icon}</span>
            <span>{pill.name}</span>
          </a>
        ))}
      </div>

      <!-- 광고 슬롯 -->
      <AdSlot format="horizontal" />

      <!-- 최신 가이드 헤더 -->
      <div class="flex items-center justify-between px-2">
        <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span>최신 생활 금융 가이드</span>
        </h2>
        <a href="/blog" class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
          전체 보기 &rarr;
        </a>
      </div>

      <!-- 포스트 카드 목록 -->
      {posts.length > 0 ? (
        <div class="flex flex-col gap-5">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="fuwari-card p-12 text-center border-emerald-100/60 dark:border-emerald-950/40">
          <p class="text-neutral-500 dark:text-neutral-400 text-sm">아직 등록된 포스트가 없습니다.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
