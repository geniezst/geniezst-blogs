---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import HeroFeatured from '../components/HeroFeatured.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import { getDb, getPublishedPosts, getCategories, getTotalPublishedPosts } from '../lib/db';
import type { BlogPost, Category } from '../types/blog';

let posts: BlogPost[] = [];
let total = 0;
let categories: Category[] = [];

const db = await getDb(Astro.locals);

if (db) {
  try {
    const [postsRes, categoriesRes, totalCount] = await Promise.all([
      getPublishedPosts(db, { limit: 10 }),
      getCategories(db),
      getTotalPublishedPosts(db),
    ]);
    posts = postsRes.posts;
    total = totalCount > 0 ? totalCount : postsRes.total;
    categories = categoriesRes;
  } catch (err) {
    console.error('Failed to fetch from D1:', err);
  }
}

const featuredPost = posts.length > 0 ? posts[0] : null;
const remainingPosts = posts.length > 1 ? posts.slice(1) : posts;

const categoryQuickPills = [
  { slug: 'welfare', name: '정부 지원금', icon: '🏛️' },
  { slug: 'tax', name: '연말정산·환급', icon: '💰' },
  { slug: 'finance', name: '예적금·금융', icon: '📈' },
  { slug: 'saving', name: '생활비 절약', icon: '⚡' },
  { slug: 'subsidy', name: '소상공인', icon: '🏪' },
  { slug: 'life-tips', name: '생활 행정', icon: '📋' },
];
---

<BaseLayout
  title="스마트 라이프 & 머니 - 놓치면 손해보는 정부 혜택과 알뜰 금융 가이드"
  description="청년·서민·직장인 필수 정부 지원금, 숨은 세금 환급금 조회, 고금리 파킹통장 비교 및 생활비 절약 실전 노하우를 가장 정확하고 알기 쉽게 전해드립니다."
>
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    <!-- 사이드바 -->
    <Sidebar categories={categories} totalPosts={total} />

    <!-- 메인 컨텐츠 영역 -->
    <div class="flex-1 w-full flex flex-col gap-8">
      <!-- 이달의 핵심 정책 가이드 히어로 카드 (최신 1위 포스트 - 모바일에서는 숨김, 데스크톱 lg에서만 표시) -->
      {featuredPost ? (
        <div class="hidden lg:block">
          <HeroFeatured post={featuredPost} />
        </div>
      ) : (
        <div class="hidden lg:block editorial-card p-6 sm:p-8 bg-gradient-to-br from-emerald-500/15 via-teal-500/8 to-transparent border-emerald-200/70 dark:border-emerald-900/50">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-600 text-white mb-3">
            <span>🏛️</span>
            <span>대한민국 복지 &amp; 알뜰 금융 가이드</span>
          </span>
          <h1 class="text-2xl sm:text-3xl font-black text-neutral-900 dark:text-white font-heading">
            내 지갑을 지키는 가장 스마트한 생활 금융 습관
          </h1>
          <p class="mt-3 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
            청년·서민·직장인 필수 정부 지원금, 숨은 연말정산 환급금 조회, 고금리 파킹통장 비교 및 실전 생활비 절약 노하우를 가장 정확하고 알기 쉽게 전해드립니다.
          </p>
        </div>
      )}

      <!-- 카테고리 퀵 필터 칩 바 (모바일에서는 숨김, 데스크톱 lg에서만 표시) -->
      <div class="hidden lg:flex editorial-card p-3 sm:p-4 border-emerald-100/70 dark:border-emerald-950/40 items-center gap-2 overflow-x-auto scrollbar-none">
        <a
          href="/blog"
          class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 text-white shrink-0 hover:bg-emerald-700 transition"
        >
          전체 보기 ({total})
        </a>
        {categoryQuickPills.map((pill) => {
          const matchedCat = categories.find((c) => c.slug === pill.slug);
          const count = matchedCat?.post_count ?? 0;
          return (
            <a
              href={`/category/${pill.slug}`}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-neutral-100 dark:bg-slate-800/70 text-neutral-700 dark:text-neutral-300 hover:bg-emerald-50 dark:hover:bg-emerald-950/50 hover:text-emerald-700 dark:hover:text-emerald-300 border border-neutral-200/60 dark:border-neutral-700/60 shrink-0 transition"
            >
              <span>{pill.icon}</span>
              <span>{pill.name}</span>
              {count > 0 && (
                <span class="text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300">
                  {count}
                </span>
              )}
            </a>
          );
        })}
      </div>

      <!-- 광고 슬롯 -->
      <AdSlot format="horizontal" />

      <!-- 최신 가이드 헤더 & 목록 -->
      <div class="flex flex-col gap-5">
        <div class="flex items-center justify-between px-1">
          <h2 class="text-xl font-bold text-neutral-900 dark:text-neutral-100 flex items-center gap-2 font-heading">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span>최신 생활 금융 &amp; 정책 가이드</span>
          </h2>
          <a href="/blog" class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
            전체 가이드 목록 ({total}) &rarr;
          </a>
        </div>

        {posts.length > 0 ? (
          <div class="flex flex-col gap-4">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        ) : (
          <div class="editorial-card p-12 text-center border-emerald-100/60 dark:border-emerald-950/40">
            <p class="text-neutral-500 dark:text-neutral-400 text-sm">등록된 가이드가 준비 중입니다.</p>
          </div>
        )}
      </div>
    </div>
  </div>
</BaseLayout>
