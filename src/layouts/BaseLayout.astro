---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { siteConfig } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  author?: string;
  canonicalUrl?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  type = 'website',
  publishedTime,
  tags,
  author = siteConfig.author,
  canonicalUrl,
} = Astro.props;
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- 웹 폰트 (Pretendard, JetBrains Mono, Titan One) 최적화 -->
    <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Titan+One&display=swap" rel="stylesheet" />

    <!-- 테마 깜빡임 방지 스크립트 -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
      author={author}
      canonicalUrl={canonicalUrl}
    />
  </head>
  <body class="min-h-screen flex flex-col antialiased selection:bg-[var(--primary)] selection:text-white bg-[var(--bg-page)] text-[var(--on-surface)]">
    <!-- Shirone Top App Bar (고정 상단바) -->
    <Header />

    <!-- Shirone Hero Banner Stage -->
    <div
      id="hero-banner"
      class="relative w-full h-[32vh] sm:h-[38vh] min-h-[220px] max-h-[360px] overflow-hidden select-none"
    >
      <img
        src="/assets/images/banner-shirone.webp"
        alt="Shirone Banner"
        class="w-full h-full object-cover object-center brightness-90 dark:brightness-75 transition-all duration-700"
      />
      <!-- 하단 자연스러운 그라디언트 페이드 -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/45 via-black/20 to-[var(--bg-page)]"></div>

      <!-- 포켓몬 스타일 pockemoney 히어로 로고 -->
      <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4 z-10 pointer-events-none">
        <a href="/" class="pointer-events-auto group inline-block transition-transform duration-300 hover:scale-105 active:scale-95">
          <span class="pokemon-logo-text select-none">
            pockemoney
          </span>
        </a>
        <div class="mt-2.5 flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full text-[11px] sm:text-xs font-bold text-white bg-black/45 backdrop-blur-md border border-white/20 shadow-lg tracking-wider">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>내 주머니 속 실전 생활 금융 &amp; 지원금 가이드</span>
          </span>
        </div>
      </div>

      <!-- 배너 우측 하단 크레딧 -->
      <div class="absolute bottom-4 right-6 text-[11px] text-white/70 font-mono tracking-wide drop-shadow hidden sm:block">
        Pocket Money • M3 Expressive
      </div>
    </div>

    <style is:global>
      /* 포켓몬 로고 스타일 pockemoney 타이포그래피 */
      .pokemon-logo-text {
        font-family: 'Titan One', cursive, sans-serif;
        font-size: clamp(2.6rem, 7.5vw, 4.6rem);
        line-height: 1.1;
        letter-spacing: 0.03em;
        color: #FFDE00;
        -webkit-text-stroke: 3.5px #2A75BB;
        paint-order: stroke fill;
        text-shadow: 
          -2px -2px 0 #2A75BB,  
           2px -2px 0 #2A75BB,
          -2px  2px 0 #2A75BB,
           2px  2px 0 #2A75BB,
           4px  4px 0 #1B3B6F,
           5px  5px 0 #1B3B6F,
           6px  6px 0 #0C2340,
           0 12px 24px rgba(0, 0, 0, 0.6);
        transform: perspective(500px) rotateX(8deg) skewX(-3deg);
        transition: transform 0.3s ease, filter 0.3s ease;
        filter: drop-shadow(0 4px 14px rgba(42, 117, 187, 0.45));
        display: inline-block;
      }

      .group:hover .pokemon-logo-text {
        transform: perspective(500px) rotateX(0deg) skewX(-1deg) scale(1.04);
        filter: drop-shadow(0 6px 18px rgba(255, 222, 0, 0.65));
      }
    </style>

    <!-- 메인 컨텐츠 영역 (배너 하단과 오버랩되는 Shirone 레이아웃) -->
    <main class="relative z-20 flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 -mt-12 sm:-mt-16 pb-16">
      <slot />
    </main>

    <!-- 푸터 -->
    <Footer />
  </body>
</html>
