---
import { siteConfig } from '../site.config';

const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-dashed border-neutral-200 dark:border-neutral-800 py-8 text-xs text-neutral-500 dark:text-neutral-400">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- 저작권 -->
    <div>
      <span>Copyright &#169; {currentYear} {siteConfig.author}. All rights reserved.</span>
    </div>

    <!-- 링크 목록 -->
    <div class="flex items-center gap-4">
      <a href="/privacy" class="link-hover">개인정보처리방침</a>
      <span>•</span>
      <a href="/contact" class="link-hover">문의하기</a>
      <span>•</span>
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-1 text-[var(--color-accent)] link-hover"
        title="RSS 피드"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
        <span>RSS</span>
      </a>
    </div>
  </div>
</footer>
