---
import type { BlogPost } from '../types/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';
---

<div class="editorial-card overflow-hidden border-emerald-200/80 dark:border-emerald-900/50 bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-white dark:to-slate-900/90 relative group">
  <!-- 상단 액센트 라인 -->
  <div class="h-1.5 bg-gradient-to-r from-emerald-600 via-teal-500 to-amber-500 w-full"></div>

  <div class="p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row gap-8 items-center">
    <!-- 텍스트 영역 -->
    <div class="flex-1 flex flex-col items-start">
      <!-- 뱃지 행 -->
      <div class="flex flex-wrap items-center gap-2 mb-3.5">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-600 text-white shadow-xs">
          <span>🔥</span>
          <span>이달의 핵심 정책 가이드</span>
        </span>
        {post.category_name && (
          <a
            href={`/category/${post.category_slug}`}
            class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100/80 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-300/60 dark:border-emerald-800/40 hover:bg-emerald-200/80 transition"
          >
            <span>🏛️</span>
            <span>{post.category_name}</span>
          </a>
        )}
      </div>

      <!-- 제목 -->
      <h2 class="text-2xl sm:text-3xl lg:text-3.5xl font-black tracking-tight text-neutral-900 dark:text-white leading-tight font-heading group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
        <a href={`/blog/${post.slug}`}>
          {post.title}
        </a>
      </h2>

      <!-- 요약 설명 -->
      <p class="mt-3.5 text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-3">
        {post.description}
      </p>

      <!-- 3대 핵심 혜택 하이라이트 칩 -->
      <div class="mt-5 flex flex-wrap gap-2 text-xs">
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/90 dark:bg-slate-800/80 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/60 dark:border-emerald-800/50 shadow-xs">
          ✓ 정부 기여금 최대 수령
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/90 dark:bg-slate-800/80 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/60 dark:border-emerald-800/50 shadow-xs">
          ✓ 이자소득 전액 비과세
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white/90 dark:bg-slate-800/80 text-emerald-800 dark:text-emerald-300 font-semibold border border-emerald-200/60 dark:border-emerald-800/50 shadow-xs">
          ✓ 모바일 3분 비대면 신청
        </span>
      </div>

      <!-- 메타 및 액션 버튼 -->
      <div class="mt-6 pt-5 border-t border-neutral-200/70 dark:border-neutral-800 w-full flex flex-wrap items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400 font-mono">
        <div class="flex items-center gap-3">
          <time datetime={post.published_at || ''}>{formattedDate}</time>
          <span>•</span>
          <span>{post.reading_time_minutes}분 정독</span>
        </div>

        <a
          href={`/blog/${post.slug}`}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 hover:-translate-y-0.5 transition-all"
        >
          <span>신청 가이드 확인하기</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>

    <!-- 썸네일/삽화 영역 -->
    {post.featured_image && (
      <div class="w-full lg:w-96 shrink-0 aspect-[16/10] sm:aspect-[16/9] lg:aspect-[4/3] rounded-2xl overflow-hidden border border-emerald-200/60 dark:border-emerald-900/60 shadow-lg relative">
        <a href={`/blog/${post.slug}`} class="block w-full h-full">
          <img
            src={post.featured_image}
            alt={post.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
        </a>
      </div>
    )}
  </div>
</div>
