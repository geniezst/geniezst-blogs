---
import type { Category } from '../types/blog';
import { siteConfig } from '../site.config';

interface Props {
  categories?: Category[];
  totalPosts?: number;
}

const { categories = [], totalPosts = 0 } = Astro.props;
const { profile } = siteConfig;
---

<aside class="w-full lg:w-72 shrink-0 flex flex-col gap-6">
  <!-- 프로필 카드 (Fuwari 시그니처) -->
  <div class="fuwari-card p-6 text-center">
    <!-- 아바타 -->
    <div class="relative w-20 h-20 mx-auto mb-4">
      {profile.avatarImage ? (
        <img
          src={profile.avatarImage}
          alt={profile.name}
          class="w-20 h-20 rounded-2xl object-cover shadow-md"
        />
      ) : (
        <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-purple-500 text-white flex items-center justify-center text-2xl font-black shadow-md">
          {profile.avatarText}
        </div>
      )}
      <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-emerald-500 border-2 border-white dark:border-neutral-900" title="Active"></span>
    </div>

    <!-- 이름 & 소개 -->
    <h3 class="text-lg font-bold text-neutral-900 dark:text-white">
      {profile.name}
    </h3>
    <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
      {profile.bio}
    </p>

    <!-- 통계 수치 바 -->
    <div class="mt-5 pt-4 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-around text-center">
      <a href="/blog" class="group">
        <span class="block text-base font-bold text-neutral-800 dark:text-neutral-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
          {totalPosts}
        </span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-medium">포스트</span>
      </a>
      <div class="w-px h-6 bg-neutral-200 dark:bg-neutral-800"></div>
      <div>
        <span class="block text-base font-bold text-neutral-800 dark:text-neutral-200">
          {categories.length}
        </span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-medium">카테고리</span>
      </div>
    </div>

    <!-- 소셜 및 RSS 링크 버튼 -->
    <div class="mt-5 flex items-center justify-center gap-2">
      {profile.github && (
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl bg-neutral-100 dark:bg-neutral-800/80 text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:scale-110 transition-all"
          title="GitHub"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>
      )}
      <a
        href="/rss.xml"
        class="p-2 rounded-xl bg-neutral-100 dark:bg-neutral-800/80 text-amber-600 dark:text-amber-400 hover:scale-110 transition-all"
        title="RSS 피드"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
      </a>
    </div>
  </div>

  <!-- 카테고리 카드 (Fuwari 시그니처) -->
  {categories.length > 0 && (
    <div class="fuwari-card p-5">
      <div class="flex items-center gap-2 mb-3 pb-2 border-b border-neutral-100 dark:border-neutral-800">
        <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <h4 class="text-xs font-bold text-neutral-800 dark:text-neutral-200 uppercase tracking-wider">
          카테고리
        </h4>
      </div>

      <ul class="space-y-1">
        {categories.map((c) => (
          <li>
            <a
              href={`/category/${c.slug}`}
              class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-100/80 dark:hover:bg-neutral-800/60 transition-all"
            >
              <span>{c.name}</span>
              <span class="text-[11px] text-neutral-400 font-mono">#{c.slug}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</aside>
