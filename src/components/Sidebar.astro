---
import type { Category } from '../types/blog';
import { siteConfig } from '../site.config';

interface Props {
  categories?: Category[];
  totalPosts?: number;
}

const { categories = [], totalPosts } = Astro.props;
const { profile } = siteConfig;

const calculatedTotal = categories.reduce((sum, c) => sum + (Number(c.post_count) || 0), 0);
const displayTotalPosts = (totalPosts !== undefined && totalPosts > 0) ? totalPosts : calculatedTotal;

const avatarSrc = profile.avatarImage || '/assets/images/avatar-shirone.webp';
---

<aside class="w-full lg:w-72 shrink-0 flex flex-col gap-6">
  <!-- Shirone M3 프로필 카드 -->
  <div class="card-base p-5 text-center">
    <!-- 모바일에서는 아바타 및 이름/소개 숨김, 데스크톱(lg)에서만 표시 -->
    <div class="hidden lg:block">
      <!-- 아바타 및 검증 마크 (Shirone 아바타 스타일) -->
      <div class="relative w-24 h-24 mx-auto mb-3.5 group">
        <img
          src={avatarSrc}
          alt={profile.name}
          class="w-24 h-24 rounded-2xl object-cover shadow-sm border border-[var(--outline-variant)] group-hover:scale-105 transition-transform duration-300"
        />
        <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-[var(--primary)] border-2 border-[var(--card-bg)] flex items-center justify-center text-[10px] text-white font-bold" title="공식 정책 검증 완료">✓</span>
      </div>

      <!-- 이름 & 소개 (Shirone 시그니처 언더라인 바) -->
      <h3 class="text-base font-bold text-[var(--on-surface)]">
        {profile.name}
      </h3>
      <div class="h-1 w-6 bg-[var(--primary)] mx-auto rounded-full my-2 transition"></div>
      <p class="text-xs text-[var(--on-surface-variant)] leading-relaxed px-1">
        {profile.bio}
      </p>
    </div>

    <!-- 통계 수치 바 (Shirone Stats Bar) -->
    <div class="lg:mt-4 lg:pt-3 lg:border-t border-[var(--outline-variant)] flex items-center justify-around text-center">
      <a href="/blog" class="group">
        <span class="block text-lg font-black text-[var(--on-surface)] group-hover:text-[var(--primary)] transition font-mono">
          {displayTotalPosts}
        </span>
        <span class="text-[11px] text-[var(--on-surface-variant)] font-medium">포스트</span>
      </a>
      <div class="w-px h-6 bg-[var(--outline-variant)]"></div>
      <div>
        <span class="block text-lg font-black text-[var(--on-surface)] font-mono">
          {categories.length}
        </span>
        <span class="text-[11px] text-[var(--on-surface-variant)] font-medium">카테고리</span>
      </div>
    </div>

    <!-- 신뢰 보증 뱃지 (상하 여백 14px 균등화) -->
    <div class="mt-3.5 py-3.5 border-t border-dashed border-[var(--outline-variant)] text-[11px] text-[var(--primary)] font-medium flex items-center justify-center gap-1">
      <span>🛡️ 100% 공공데이터 기준 검증</span>
    </div>
  </div>

  <!-- Shirone 카테고리 카드 (모바일 기본 접힘, 데스크톱 항상 펼침) -->
  {categories.length > 0 && (
    <div class="card-base p-5">
      <!-- 반응형 헤더 (Shirone WidgetLayout Header) -->
      <button
        type="button"
        id="blogs-category-toggle-btn"
        class="w-full flex items-center justify-between text-left cursor-pointer lg:cursor-default group"
        aria-expanded="false"
        aria-controls="blogs-category-list"
      >
        <div class="flex items-center gap-2">
          <span class="w-1 h-4 rounded-full bg-[var(--primary)] shrink-0"></span>
          <h4 class="text-sm font-bold text-[var(--on-surface)] tracking-tight">
            카테고리
          </h4>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] font-semibold">
            {categories.length}
          </span>
        </div>

        <!-- 모바일 전용 토글 화살표 & 상태 힌트 -->
        <div class="flex items-center gap-1 text-[var(--on-surface-variant)] lg:hidden">
          <span class="text-[11px] font-medium" id="blogs-category-toggle-text">목록 보기</span>
          <svg
            id="blogs-category-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <!-- 카테고리 목록 (모바일 hidden, 데스크톱 lg:block) -->
      <div id="blogs-category-list" class="hidden lg:block pt-3 mt-3 border-t border-[var(--outline-variant)]">
        <ul class="space-y-1">
          {categories.map((c) => (
            <li>
              <a
                href={`/category/${c.slug}`}
                class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-[var(--on-surface-variant)] hover:text-[var(--primary)] hover:bg-[var(--primary-container)]/50 transition group"
              >
                <span class="flex items-center gap-2 truncate">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] shrink-0"></span>
                  <span class="truncate">{c.name}</span>
                </span>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] group-hover:bg-[var(--primary)] group-hover:text-white transition shrink-0 font-semibold">
                  {c.post_count ?? 0}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <!-- Shirone RSS 피드 카드 -->
  <div class="card-base p-4 text-center">
    <a
      href="/rss.xml"
      class="w-full inline-flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-[var(--surface-container-low)] hover:bg-[var(--primary-container)] text-[var(--primary)] text-xs font-bold transition scale-animation border border-[var(--outline-variant)]"
    >
      <svg class="w-4 h-4 text-[var(--primary)]" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
      </svg>
      <span>RSS 구독</span>
    </a>
  </div>
</aside>

<script>
  function initBlogsCategoryToggle() {
    const toggleBtn = document.getElementById('blogs-category-toggle-btn');
    const categoryList = document.getElementById('blogs-category-list');
    const chevron = document.getElementById('blogs-category-chevron');
    const toggleText = document.getElementById('blogs-category-toggle-text');

    if (!toggleBtn || !categoryList) return;

    toggleBtn.onclick = () => {
      if (window.innerWidth >= 1024) return;
      const isHidden = categoryList.classList.contains('hidden');
      if (isHidden) {
        categoryList.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
        if (toggleText) toggleText.textContent = '접기';
      } else {
        categoryList.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (chevron) chevron.classList.remove('rotate-180');
        if (toggleText) toggleText.textContent = '목록 보기';
      }
    };
  }

  initBlogsCategoryToggle();
  document.addEventListener('astro:page-load', initBlogsCategoryToggle);
</script>
