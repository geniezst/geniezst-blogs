---
import type { Category } from '../types/blog';
import { siteConfig } from '../site.config';

interface Props {
  categories?: Category[];
  totalPosts?: number;
}

const { categories = [], totalPosts } = Astro.props;
const { profile } = siteConfig;

// post_count 합산 또는 전달받은 totalPosts 사용 (0으로 고정되는 문제 완전 해결)
const calculatedTotal = categories.reduce((sum, c) => sum + (Number(c.post_count) || 0), 0);
const displayTotalPosts = (totalPosts !== undefined && totalPosts > 0) ? totalPosts : calculatedTotal;

const categoryDotColors: Record<string, string> = {
  welfare: 'bg-emerald-500',
  tax: 'bg-amber-500',
  finance: 'bg-blue-500',
  saving: 'bg-teal-500',
  subsidy: 'bg-violet-500',
  'life-tips': 'bg-rose-500',
};
---

<aside class="w-full lg:w-72 shrink-0 flex flex-col gap-6">
  <!-- Fumika 프로필 카드 -->
  <div class="card-base p-4 sm:p-5 lg:p-6 pb-0 sm:pb-0 lg:pb-0 text-center">
    <!-- 모바일에서는 아바타 및 이름/소개 숨김, 데스크톱(lg)에서만 표시 -->
    <div class="hidden lg:block">
      <!-- 아바타 및 검증 마크 -->
      <div class="relative w-20 h-20 mx-auto mb-4">
        {profile.avatarImage ? (
          <img
            src={profile.avatarImage}
            alt={profile.name}
            class="w-20 h-20 rounded-2xl object-cover shadow-md"
          />
        ) : (
          <div class="w-20 h-20 rounded-2xl bg-gradient-to-tr from-emerald-600 via-teal-600 to-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-600/20">
            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
        )}
        <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-500 border-2 border-white dark:border-slate-900 flex items-center justify-center text-[10px] text-white font-bold" title="공식 정책 검증 완료">✓</span>
      </div>

      <!-- 이름 & 소개 -->
      <h3 class="text-base font-bold text-neutral-900 dark:text-white">
        {profile.name}
      </h3>
      <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed px-1">
        {profile.bio}
      </p>
    </div>

    <!-- 통계 수치 바 (포스트 수 정확히 표시 - 모바일에서는 카드 상단에 바로 배치) -->
    <div class="lg:mt-5 lg:pt-4 lg:border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-around text-center">
      <a href="/blog" class="group">
        <span class="block text-lg font-black text-neutral-800 dark:text-neutral-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition font-mono">
          {displayTotalPosts}
        </span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-medium">포스트</span>
      </a>
      <div class="w-px h-6 bg-neutral-200 dark:bg-neutral-800"></div>
      <div>
        <span class="block text-lg font-black text-neutral-800 dark:text-neutral-200 font-mono">
          {categories.length}
        </span>
        <span class="text-[11px] text-neutral-400 dark:text-neutral-500 font-medium">카테고리</span>
      </div>
    </div>

    <!-- 신뢰 보증 뱃지 (상하 여백 14px 균등화) -->
    <div class="mt-3.5 py-3.5 border-t border-dashed border-neutral-200/70 dark:border-neutral-800/60 text-[11px] text-emerald-700 dark:text-emerald-300 font-medium flex items-center justify-center gap-1">
      <span>🛡️ 100% 공공데이터 기준 검증</span>
    </div>
  </div>

  <!-- Fumika 카테고리 카드 (모바일 기본 접힘, 데스크톱 항상 펼침) -->
  {categories.length > 0 && (
    <div class="card-base p-4 sm:p-5">
      <!-- 반응형 헤더 (모바일 토글 버튼) -->
      <button
        type="button"
        id="blogs-category-toggle-btn"
        class="w-full flex items-center justify-between text-left cursor-pointer lg:cursor-default group"
        aria-expanded="false"
        aria-controls="blogs-category-list"
      >
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <h4 class="text-xs font-bold text-neutral-900 dark:text-neutral-100 uppercase tracking-wider">
            생활 금융 카테고리
          </h4>
          <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-slate-800 text-neutral-500 dark:text-neutral-400 font-semibold">
            {categories.length}
          </span>
        </div>

        <!-- 모바일 전용 토글 화살표 & 상태 힌트 -->
        <div class="flex items-center gap-1 text-neutral-400 dark:text-neutral-500 lg:hidden">
          <span class="text-[11px] font-medium" id="blogs-category-toggle-text">목록 보기</span>
          <svg
            id="blogs-category-chevron"
            class="w-4 h-4 transition-transform duration-200"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </div>
      </button>

      <!-- 카테고리 목록 (모바일 hidden, 데스크톱 lg:block) -->
      <div id="blogs-category-list" class="hidden lg:block pt-3 mt-2.5 border-t border-neutral-100 dark:border-neutral-800">
        <ul class="space-y-1">
          {categories.map((c) => {
            const dotColor = categoryDotColors[c.slug] || 'bg-emerald-500';
            return (
              <li>
                <a
                  href={`/category/${c.slug}`}
                  class="flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-neutral-700 dark:text-neutral-300 hover:text-emerald-700 dark:hover:text-emerald-300 hover:bg-emerald-50/80 dark:hover:bg-emerald-950/40 transition group"
                >
                  <span class="flex items-center gap-2 truncate">
                    <span class={`w-2 h-2 rounded-full ${dotColor} shrink-0`}></span>
                    <span class="truncate">{c.name}</span>
                  </span>
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-slate-800 text-neutral-500 dark:text-neutral-400 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-950 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition shrink-0 font-semibold">
                    {c.post_count ?? 0}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  )}

  <!-- Fumika RSS 피드 카드 -->
  <div class="card-base p-4 text-center">
    <a
      href="/rss.xml"
      class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 text-xs font-bold transition scale-animation"
    >
      <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
      </svg>
      <span>신규 복지 알림 RSS 구독</span>
    </a>
  </div>
</aside>

<script>
  function initBlogsCategoryToggle() {
    const toggleBtn = document.getElementById('blogs-category-toggle-btn');
    const categoryList = document.getElementById('blogs-category-list');
    const chevron = document.getElementById('blogs-category-chevron');
    const toggleText = document.getElementById('blogs-category-toggle-text');

    if (!toggleBtn || !categoryList) return;

    toggleBtn.onclick = () => {
      if (window.innerWidth >= 1024) return;
      const isHidden = categoryList.classList.contains('hidden');
      if (isHidden) {
        categoryList.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
        if (toggleText) toggleText.textContent = '접기';
      } else {
        categoryList.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (chevron) chevron.classList.remove('rotate-180');
        if (toggleText) toggleText.textContent = '목록 보기';
      }
    };
  }

  initBlogsCategoryToggle();
  document.addEventListener('astro:page-load', initBlogsCategoryToggle);
</script>
