---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

const navItems = siteConfig.nav;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header
  id="navbar"
  class="top-app-bar fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="max-w-6xl mx-auto h-16 px-4 md:px-6 flex items-center justify-between gap-2">
    <!-- 모바일 햄버거 메뉴 버튼 -->
    <button
      id="nav-drawer-toggle"
      type="button"
      aria-label="메뉴 열기"
      class="p-2 rounded-xl text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)]/60 hover:text-[var(--primary)] lg:hidden shrink-0 transition cursor-pointer"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Shirone Logo: Expanding Accent Bar + Title -->
    <a
      href="/"
      class="group flex h-10 items-center gap-2.5 px-2 text-[var(--on-surface)] transition whitespace-nowrap"
    >
      <span class="h-5 w-1 rounded-full bg-[var(--primary)] transition-all duration-300 group-hover:h-7 shrink-0"></span>
      <span class="text-base sm:text-lg font-bold tracking-tight group-hover:text-[var(--primary)] transition-colors">
        {siteConfig.title}
      </span>
    </a>

    <!-- 데스크톱 내비게이션 메뉴 (Shirone M3 Top App Bar Link) -->
    <nav class="hidden lg:flex h-full items-center gap-1 ml-6" aria-label="메인 내비게이션">
      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "top-app-bar__nav-link relative flex h-10 items-center px-4 text-sm font-bold transition-colors",
              isActive
                ? "top-app-bar__nav-link--active text-[var(--primary)]"
                : "text-[var(--on-surface-variant)] hover:text-[var(--on-surface)] hover:bg-[var(--primary-container)]/40 rounded-xl"
            ]}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex-1"></div>

    <!-- 우측 도구: 검색 & 다크모드 스위치 -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/search"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-[var(--on-surface-variant)] hover:text-[var(--primary)] hover:bg-[var(--primary-container)]/60 transition"
        title="검색"
        aria-label="가이드 검색"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">검색</span>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>

<!-- 모바일 내비게이션 드로어 (Shirone SiteNavigationDrawer) -->
<div
  id="nav-drawer"
  class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0"
  aria-hidden="true"
>
  <!-- 배경 딤 -->
  <div id="nav-drawer-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-xs transition-opacity duration-300"></div>

  <!-- 드로어 패널 -->
  <div
    id="nav-drawer-panel"
    class="absolute top-0 bottom-0 left-0 w-72 max-w-[85vw] bg-[var(--card-bg)] text-[var(--on-surface)] p-6 shadow-2xl border-r border-[var(--outline-variant)] -translate-x-full transition-transform duration-300 ease-out flex flex-col justify-between"
  >
    <div>
      <div class="flex items-center justify-between pb-5 border-b border-[var(--outline-variant)]">
        <div class="flex items-center gap-2">
          <span class="h-5 w-1 rounded-full bg-[var(--primary)]"></span>
          <span class="font-bold text-base text-[var(--on-surface)]">{siteConfig.title}</span>
        </div>
        <button
          id="nav-drawer-close"
          type="button"
          aria-label="메뉴 닫기"
          class="p-1.5 rounded-lg text-[var(--on-surface-variant)] hover:bg-[var(--surface-container)] transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="mt-6 flex flex-col gap-1.5" aria-label="모바일 내비게이션">
        {navItems.map((item) => {
          const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-bold transition",
                isActive
                  ? "bg-[var(--primary-container)] text-[var(--on-primary-container)] font-black"
                  : "text-[var(--on-surface-variant)] hover:bg-[var(--surface-container)] hover:text-[var(--primary)]"
              ]}
            >
              <span>{item.label}</span>
            </a>
          );
        })}
      </nav>
    </div>

    <!-- 드로어 하단 정보 -->
    <div class="pt-4 border-t border-[var(--outline-variant)] text-xs text-[var(--on-surface-variant)]">
      <p class="font-medium">스마트 라이프 &amp; 머니</p>
      <p class="text-[11px] opacity-75 mt-0.5">Shirone Theme • M3 Expressive</p>
    </div>
  </div>
</div>

<script>
  function setupTopAppBar() {
    const navbar = document.getElementById('navbar');
    const heroBanner = document.getElementById('hero-banner');

    function handleScroll() {
      const scrollY = window.scrollY;
      const bannerHeight = heroBanner ? heroBanner.offsetHeight : 0;
      
      // 배너 영역 위에 있을 때: 투명 헤더
      if (heroBanner && scrollY < bannerHeight - 64) {
        navbar?.classList.add('top-app-bar--transparent');
        navbar?.classList.remove('top-app-bar--scrolled');
      } else {
        navbar?.classList.remove('top-app-bar--transparent');
        if (scrollY > 20) {
          navbar?.classList.add('top-app-bar--scrolled');
        } else {
          navbar?.classList.remove('top-app-bar--scrolled');
        }
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // 모바일 드로어
    const toggleBtn = document.getElementById('nav-drawer-toggle');
    const closeBtn = document.getElementById('nav-drawer-close');
    const drawer = document.getElementById('nav-drawer');
    const backdrop = document.getElementById('nav-drawer-backdrop');
    const panel = document.getElementById('nav-drawer-panel');

    function openDrawer() {
      if (!drawer || !panel) return;
      drawer.classList.remove('pointer-events-none', 'opacity-0');
      drawer.classList.add('pointer-events-auto', 'opacity-100');
      drawer.setAttribute('aria-hidden', 'false');
      panel.classList.remove('-translate-x-full');
      panel.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      if (!drawer || !panel) return;
      drawer.classList.remove('pointer-events-auto', 'opacity-100');
      drawer.classList.add('pointer-events-none', 'opacity-0');
      drawer.setAttribute('aria-hidden', 'true');
      panel.classList.remove('translate-x-0');
      panel.classList.add('-translate-x-full');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
  }

  setupTopAppBar();
  document.addEventListener('astro:page-load', setupTopAppBar);
</script>
