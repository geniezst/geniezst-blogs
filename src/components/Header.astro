---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

const navItems = siteConfig.nav;
---

<header class="sticky top-3 z-50 w-full mb-6 sm:mb-8 px-4 sm:px-6">
  <!-- Fumika Floating Card Navigation Bar -->
  <div class="max-w-6xl mx-auto">
    <div class="card-base px-4 sm:px-6 h-16 sm:h-[4.25rem] flex items-center justify-between">
      <!-- 로고 -->
      <a href="/" class="flex items-center gap-3 group scale-animation">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center shadow-md shadow-emerald-600/20 group-hover:rotate-6 transition-transform duration-300">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-black text-base sm:text-lg tracking-tight text-neutral-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            {siteConfig.title}
          </span>
          <span class="text-[10px] font-semibold tracking-wider text-emerald-600 dark:text-emerald-400 uppercase -mt-0.5">
            Fumika • Smart Money
          </span>
        </div>
      </a>

      <!-- 중앙 내비게이션 메뉴 (Fumika btn-plain 스타일) -->
      <nav class="hidden md:flex items-center gap-1.5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="btn-plain scale-animation px-4 py-2 rounded-xl text-sm font-semibold text-neutral-700 dark:text-neutral-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- 우측 도구: 빠른 검색 & 다크모드 스위치 -->
      <div class="flex items-center gap-2">
        <a
          href="/search"
          class="btn-plain scale-animation p-2.5 rounded-xl text-neutral-600 dark:text-neutral-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition flex items-center gap-1.5 text-xs font-semibold"
          title="검색"
          aria-label="가이드 검색"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">검색</span>
        </a>

        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
