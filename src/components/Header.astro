---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

const navItems = siteConfig.nav;
---

<header class="sticky top-0 z-50 w-full mb-6 sm:mb-8">
  <!-- Fumika Top-Attached Navigation Bar -->
  <div class="card-base !rounded-t-none rounded-b-2xl max-w-6xl mx-auto h-[4.5rem] px-4 sm:px-6 flex items-center justify-between border-t-0 shadow-md backdrop-blur-md">
    <!-- Fumika Home Button with Home Icon & Title -->
    <a href="/" class="scale-animation flex items-center gap-2.5 text-emerald-600 dark:text-emerald-400 font-bold active:scale-95 py-2 px-3 rounded-xl hover:bg-emerald-50 dark:hover:bg-emerald-950/50 transition">
      <svg class="w-6 h-6 shrink-0 mb-0.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <div class="flex flex-col">
        <span class="font-black text-base sm:text-lg tracking-tight text-neutral-900 dark:text-white leading-tight">
          {siteConfig.title}
        </span>
        <span class="text-[10px] font-semibold tracking-wider text-emerald-600 dark:text-emerald-400 uppercase -mt-0.5">
          Fumika • Smart Money
        </span>
      </div>
    </a>

    <!-- 중앙 내비게이션 메뉴 (Fumika btn-plain 스타일) -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="btn-plain scale-animation px-4 py-2 rounded-xl text-sm font-bold text-neutral-700 dark:text-neutral-200 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50/70 dark:hover:bg-emerald-950/50 transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- 우측 도구: 검색 & 다크모드 스위치 -->
    <div class="flex items-center gap-2">
      <a
        href="/search"
        class="scale-animation p-2.5 rounded-xl text-neutral-600 dark:text-neutral-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-emerald-50/70 dark:hover:bg-emerald-950/50 transition flex items-center gap-1.5 text-xs font-semibold"
        title="검색"
        aria-label="가이드 검색"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline font-bold">검색</span>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>
