---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

const navItems = siteConfig.nav;
---

<header class="sticky top-0 z-50 w-full mb-6 sm:mb-8">
  <!-- Shirone Top App Bar -->
  <div class="card-base !rounded-t-none rounded-b-2xl max-w-6xl mx-auto h-[4.5rem] px-4 sm:px-6 flex items-center justify-between border-t-0 shadow-sm backdrop-blur-md">
    <!-- Shirone Logo: Expanding Accent Bar + Title -->
    <a href="/" class="scale-animation flex items-center gap-2.5 active:scale-95 py-2 px-3 rounded-xl transition group">
      <span class="h-5 w-1.5 rounded-full bg-[var(--primary)] transition-all group-hover:h-6 shrink-0"></span>
      <div class="flex flex-col">
        <span class="font-black text-base sm:text-lg tracking-tight text-neutral-900 dark:text-white leading-tight group-hover:text-[var(--primary)] transition-colors">
          {siteConfig.title}
        </span>
        <span class="text-[10px] font-semibold tracking-wider text-[var(--primary)] uppercase -mt-0.5">
          Shirone • Smart Money
        </span>
      </div>
    </a>

    <!-- 중앙 내비게이션 메뉴 (Shirone M3 State Layer 스타일) -->
    <nav class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="btn-plain scale-animation px-4 py-2 rounded-full text-sm font-bold text-neutral-700 dark:text-neutral-200 hover:text-[var(--primary)] hover:bg-[var(--primary-container)]/70 dark:hover:bg-[var(--primary-container)]/50 transition"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- 우측 도구: 검색 & 다크모드 스위치 -->
    <div class="flex items-center gap-2">
      <a
        href="/search"
        class="scale-animation p-2.5 rounded-full text-neutral-600 dark:text-neutral-300 hover:text-[var(--primary)] hover:bg-[var(--primary-container)]/70 dark:hover:bg-[var(--primary-container)]/50 transition flex items-center gap-1.5 text-xs font-semibold"
        title="검색"
        aria-label="가이드 검색"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline font-bold">검색</span>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>
