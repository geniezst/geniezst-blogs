---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../site.config';

const navItems = siteConfig.nav;
---

<header class="sticky top-4 z-50 max-w-6xl mx-auto px-4 sm:px-6 mb-6">
  <div class="fuwari-card px-4 sm:px-6 h-14 flex items-center justify-between">
    <!-- 로고 -->
    <a href="/" class="flex items-center gap-2.5 group">
      <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 text-white flex items-center justify-center text-sm font-black shadow-sm group-hover:scale-105 transition-transform duration-300">
        {siteConfig.profile.avatarText}
      </span>
      <span class="font-extrabold text-base sm:text-lg tracking-tight text-neutral-800 dark:text-neutral-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        {siteConfig.title}
      </span>
    </a>

    <!-- 중앙 내비게이션 -->
    <nav class="flex items-center gap-1 sm:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition-all"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- 우측 도구: 검색 & 테마 토글 -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <a
        href="/search"
        class="p-2 rounded-xl text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-100 dark:hover:bg-neutral-800/60 transition"
        title="검색"
        aria-label="검색"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </a>

      <ThemeToggle />
    </div>
  </div>
</header>
