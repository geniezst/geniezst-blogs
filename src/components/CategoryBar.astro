---
import type { Category } from '../types/blog';

interface Props {
  categories?: Category[];
  currentCategory?: string;
  totalPosts?: number;
}

const { categories = [], currentCategory, totalPosts } = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = pathname === '';
const isBlogAll = pathname === '/blog';
---

<nav
  id="category-bar"
  aria-label="카테고리 내비게이션"
  class="card-base p-2.5 mb-6 overflow-hidden"
>
  <div class="flex items-center gap-2 overflow-x-auto hide-scrollbar scroll-smooth py-0.5 px-0.5">
    <!-- 홈 Chip -->
    <a
      href="/"
      class:list={[
        "m3-chip shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all duration-200",
        isHome
          ? "bg-[var(--primary)] text-white shadow-sm"
          : "bg-[var(--surface-container-low)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)]/70 hover:text-[var(--primary)]",
      ]}
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>홈</span>
    </a>

    <!-- 전체 보기 Chip -->
    <a
      href="/blog"
      class:list={[
        "m3-chip shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold transition-all duration-200",
        isBlogAll && !currentCategory
          ? "bg-[var(--primary)] text-white shadow-sm"
          : "bg-[var(--surface-container-low)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)]/70 hover:text-[var(--primary)]",
      ]}
    >
      <span>전체</span>
      {totalPosts !== undefined && totalPosts > 0 && (
        <span
          class:list={[
            "text-[10px] font-mono px-1.5 py-0.2 rounded-full font-semibold",
            isBlogAll && !currentCategory
              ? "bg-white/20 text-white"
              : "bg-[var(--surface-container-high)] text-[var(--on-surface-variant)]",
          ]}
        >
          {totalPosts}
        </span>
      )}
    </a>

    <!-- 구분선 -->
    <div class="w-px h-5 bg-[var(--outline-variant)] shrink-0 mx-0.5"></div>

    <!-- 카테고리 Chip 목록 -->
    {categories.map((c) => {
      const isSelected = currentCategory === c.slug;
      return (
        <a
          href={`/category/${c.slug}`}
          class:list={[
            "m3-chip shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium transition-all duration-200",
            isSelected
              ? "bg-[var(--primary)] text-white font-bold shadow-sm"
              : "bg-[var(--surface-container-low)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)]/70 hover:text-[var(--primary)]",
          ]}
        >
          <span>{c.name}</span>
          {c.post_count !== undefined && c.post_count > 0 && (
            <span
              class:list={[
                "text-[10px] font-mono px-1.5 py-0.2 rounded-full font-semibold",
                isSelected
                  ? "bg-white/20 text-white"
                  : "bg-[var(--surface-container-high)] text-[var(--on-surface-variant)]",
              ]}
            >
              {c.post_count}
            </span>
          )}
        </a>
      );
    })}
  </div>
</nav>

<style>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
