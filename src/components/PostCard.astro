---
import type { BlogPost } from '../types/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';

// 6대 카테고리별 맞춤형 뱃지 스타일
const categoryBadgeStyles: Record<string, { bg: string; dot: string; icon: string }> = {
  welfare: {
    bg: 'bg-emerald-50 text-emerald-700 border-emerald-200/70 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800/40',
    dot: 'bg-emerald-500',
    icon: '🏛️',
  },
  tax: {
    bg: 'bg-amber-50 text-amber-700 border-amber-200/70 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800/40',
    dot: 'bg-amber-500',
    icon: '💰',
  },
  finance: {
    bg: 'bg-blue-50 text-blue-700 border-blue-200/70 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800/40',
    dot: 'bg-blue-500',
    icon: '📈',
  },
  saving: {
    bg: 'bg-teal-50 text-teal-700 border-teal-200/70 dark:bg-teal-950/60 dark:text-teal-300 dark:border-teal-800/40',
    dot: 'bg-teal-500',
    icon: '⚡',
  },
  subsidy: {
    bg: 'bg-violet-50 text-violet-700 border-violet-200/70 dark:bg-violet-950/60 dark:text-violet-300 dark:border-violet-800/40',
    dot: 'bg-violet-500',
    icon: '🏪',
  },
  'life-tips': {
    bg: 'bg-rose-50 text-rose-700 border-rose-200/70 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800/40',
    dot: 'bg-rose-500',
    icon: '📋',
  },
};

const badgeStyle = (post.category_slug && categoryBadgeStyles[post.category_slug]) || {
  bg: 'bg-emerald-50 text-emerald-700 border-emerald-200/70 dark:bg-emerald-950/60 dark:text-emerald-300 dark:border-emerald-800/40',
  dot: 'bg-emerald-500',
  icon: '💡',
};
---

<article class="fuwari-card p-6 sm:p-7 relative overflow-hidden group hover:-translate-y-1 cursor-pointer border-emerald-100/70 dark:border-emerald-950/50">
  <!-- 상단 호버 시 나타나는 에메랄드 액센트 탑 라인 -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <!-- 상단 메타 & 카테고리 뱃지 -->
  <div class="flex items-center justify-between gap-2 mb-3">
    {post.category_name ? (
      <a
        href={`/category/${post.category_slug}`}
        class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold border relative z-10 hover:opacity-85 transition ${badgeStyle.bg}`}
      >
        <span>{badgeStyle.icon}</span>
        <span>{post.category_name}</span>
      </a>
    ) : <div></div>}

    <!-- 읽는 시간 -->
    <span class="inline-flex items-center gap-1 text-xs text-neutral-400 dark:text-neutral-500 font-mono">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{post.reading_time_minutes || 4}분 정독</span>
    </span>
  </div>

  <!-- 포스트 제목 -->
  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors leading-snug mb-3">
    <a href={`/blog/${post.slug}`} class="focus:outline-none">
      <span class="absolute inset-0 z-0"></span>
      {post.title}
    </a>
  </h3>

  <!-- 포스트 요약 설명 -->
  <p class="text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed mb-4">
    {post.description}
  </p>

  <!-- 하단 푸터 메타 -->
  <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/70 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500">
    <div class="flex items-center gap-1.5 font-mono">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <time datetime={post.published_at || ''}>{formattedDate}</time>
    </div>

    <span class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400 group-hover:translate-x-1 transition-transform">
      <span>신청 가이드 확인</span>
      <span>&rarr;</span>
    </span>
  </div>
</article>
