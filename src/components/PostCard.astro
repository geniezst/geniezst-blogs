---
import type { BlogPost } from '../types/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<article class="fuwari-card p-6 sm:p-7 relative overflow-hidden group hover:-translate-y-1 cursor-pointer">
  <!-- 상단 메타 & 카테고리 뱃지 -->
  <div class="flex items-center justify-between gap-2 mb-3">
    {post.category_name ? (
      <a
        href={`/category/${post.category_slug}`}
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200/50 dark:border-blue-900/40 relative z-10 hover:opacity-80 transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        <span>{post.category_name}</span>
      </a>
    ) : <div></div>}

    <!-- 읽는 시간 -->
    <span class="inline-flex items-center gap-1 text-xs text-neutral-400 dark:text-neutral-500 font-mono">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>{post.reading_time_minutes || 5}분 소요</span>
    </span>
  </div>

  <!-- 포스트 제목 -->
  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug mb-3">
    <a href={`/blog/${post.slug}`} class="focus:outline-none">
      <span class="absolute inset-0 z-0"></span>
      {post.title}
    </a>
  </h3>

  <!-- 포스트 요약 설명 -->
  <p class="text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed mb-4">
    {post.description}
  </p>

  <!-- 하단 푸터 메타 -->
  <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between text-xs text-neutral-400 dark:text-neutral-500">
    <div class="flex items-center gap-1.5 font-mono">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <time datetime={post.published_at || ''}>{formattedDate}</time>
    </div>

    <span class="inline-flex items-center gap-1 font-semibold text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform">
      <span>읽기</span>
      <span>&rarr;</span>
    </span>
  </div>
</article>
