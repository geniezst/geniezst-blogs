---
import type { BlogPost } from '../types/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';

// 6대 카테고리별 아이콘 매핑
const categoryIcons: Record<string, string> = {
  welfare: '🏛️',
  tax: '💰',
  finance: '📈',
  saving: '⚡',
  subsidy: '🏪',
  'life-tips': '📋',
};

const categoryIcon = (post.category_slug && categoryIcons[post.category_slug]) || '💡';
---

<!-- Shirone M3 PostCard -->
<article class="card-base m3-blog-postcard relative flex flex-col-reverse md:flex-row w-full overflow-hidden p-5 sm:p-6 group transition-all duration-300">
  <!-- 본문 영역 -->
  <div class:list={[
    "flex-1 flex flex-col justify-between min-w-0",
    { "pr-0 md:pr-4": !post.featured_image, "pr-0 md:pr-6": post.featured_image }
  ]}>
    <div>
      <!-- 제목 (Shirone 시그니처 AccentBar + 슬라이딩 화살표) -->
      <a
        href={`/blog/${post.slug}`}
        class="group/title flex items-center gap-2.5 font-bold text-lg sm:text-xl text-[var(--on-surface)] group-hover:text-[var(--primary)] transition-colors leading-snug"
      >
        <span class="w-1 h-5 rounded-full bg-[var(--primary)] shrink-0 transition-all duration-200 group-hover:h-6"></span>
        <span class="flex-1 font-heading">{post.title}</span>
        <svg
          class="w-5 h-5 text-[var(--primary)] opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-200 shrink-0 hidden md:block"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Shirone 메타데이터 (카테고리 M3 Chip, 발행일, 정독 시간) -->
      <div class="flex flex-wrap items-center gap-3 text-xs text-[var(--on-surface-variant)] font-mono mt-3 mb-2.5">
        {post.category_name && (
          <a
            href={`/category/${post.category_slug}`}
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-[var(--surface-container-high)] text-[var(--on-surface-variant)] hover:bg-[var(--primary-container)] hover:text-[var(--primary)] transition"
          >
            <span>{categoryIcon}</span>
            <span>{post.category_name}</span>
          </a>
        )}

        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={post.published_at || ''}>{formattedDate}</time>
        </span>

        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{post.reading_time_minutes || 4}분 정독</span>
        </span>

        {post.view_count > 0 && (
          <span class="hidden sm:inline-flex items-center gap-1">
            <span>•</span>
            <span>조회 {post.view_count}</span>
          </span>
        )}
      </div>

      <!-- 요약 설명 -->
      <p class="text-sm text-[var(--on-surface-variant)] line-clamp-2 leading-relaxed mt-2">
        {post.description}
      </p>
    </div>
  </div>

  <!-- Shirone 데스크톱 28% 우측 커버 썸네일 & 줌 오버레이 (모바일에서는 상단) -->
  {post.featured_image && (
    <a
      href={`/blog/${post.slug}`}
      aria-label={post.title}
      class="group/cover relative w-full md:w-[28%] shrink-0 mb-3 md:mb-0 aspect-[16/9] md:aspect-auto rounded-xl overflow-hidden bg-[var(--surface-container-low)]"
    >
      <img
        src={post.featured_image}
        alt={post.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
      <!-- Shirone Hover dark mask with centered white chevron -->
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
        <svg
          class="w-10 h-10 text-white opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>
  )}

  <!-- 커버 이미지가 없을 때: Shirone M3 우측 엔터 화살표 버튼 -->
  {!post.featured_image && (
    <a
      href={`/blog/${post.slug}`}
      aria-label={post.title}
      class="hidden md:flex w-12 rounded-xl bg-[var(--surface-container-low)] hover:bg-[var(--primary-container)] text-[var(--primary)] items-center justify-center transition shrink-0"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}
</article>
