---
import type { BlogPost } from '../types/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const formattedDate = post.published_at
  ? new Date(post.published_at).toLocaleDateString('ko-KR', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';

// 6대 카테고리별 맞춤형 뱃지 스타일 (Shirone M3 Pill Style)
const categoryBadgeStyles: Record<string, { bg: string; icon: string }> = {
  welfare: {
    bg: 'bg-rose-50 text-rose-700 border-rose-200/70 dark:bg-rose-950/60 dark:text-rose-300 dark:border-rose-800/40',
    icon: '🏛️',
  },
  tax: {
    bg: 'bg-amber-50 text-amber-700 border-amber-200/70 dark:bg-amber-950/60 dark:text-amber-300 dark:border-amber-800/40',
    icon: '💰',
  },
  finance: {
    bg: 'bg-purple-50 text-purple-700 border-purple-200/70 dark:bg-purple-950/60 dark:text-purple-300 dark:border-purple-800/40',
    icon: '📈',
  },
  saving: {
    bg: 'bg-pink-50 text-pink-700 border-pink-200/70 dark:bg-pink-950/60 dark:text-pink-300 dark:border-pink-800/40',
    icon: '⚡',
  },
  subsidy: {
    bg: 'bg-violet-50 text-violet-700 border-violet-200/70 dark:bg-violet-950/60 dark:text-violet-300 dark:border-violet-800/40',
    icon: '🏪',
  },
  'life-tips': {
    bg: 'bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200/70 dark:bg-fuchsia-950/60 dark:text-fuchsia-300 dark:border-fuchsia-800/40',
    icon: '📋',
  },
};

const badgeStyle = (post.category_slug && categoryBadgeStyles[post.category_slug]) || {
  bg: 'bg-pink-50 text-pink-700 border-pink-200/70 dark:bg-pink-950/60 dark:text-pink-300 dark:border-pink-800/40',
  icon: '💡',
};
---

<!-- Shirone M3 PostCard -->
<div class="card-base flex flex-col-reverse md:flex-col w-full rounded-2xl overflow-hidden relative group hover:shadow-xl transition-all duration-300 p-5 sm:p-6">
  <!-- 상단 호버 시 나타나는 Shirone 로즈-퍼플 액센트 라인 -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-pink-500 via-purple-500 to-rose-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <!-- 카드 본문 정보 영역 -->
  <div class:list={[
    "relative flex flex-col justify-between",
    { "w-full md:w-[calc(100%_-_52px_-_16px)]": !post.featured_image, "w-full md:w-[calc(100%_-_28%_-_16px)]": post.featured_image }
  ]}>
    <div>
      <!-- 포스트 제목 (Shirone 시그니처 AccentBar 적용) -->
      <a
        href={`/blog/${post.slug}`}
        class="transition group/title w-full block font-bold mb-3 text-lg sm:text-2xl text-neutral-900 dark:text-white hover:text-[var(--primary)] font-heading relative md:pl-0 before:w-1.5 before:h-5 before:rounded-md before:bg-[var(--primary)] before:absolute before:top-1.5 before:-left-4 before:hidden md:before:block"
      >
        <span>{post.title}</span>
        <svg class="inline w-5 h-5 text-[var(--primary)] md:hidden translate-y-0.5 ml-1 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <!-- Shirone 메타데이터 (카테고리 뱃지, 발행일, 정독 시간) -->
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 text-xs text-neutral-400 dark:text-neutral-500 font-mono mb-3">
        {post.category_name && (
          <a
            href={`/category/${post.category_slug}`}
            class={`badge-pill border relative z-10 hover:opacity-85 transition ${badgeStyle.bg}`}
          >
            <span>{badgeStyle.icon}</span>
            <span>{post.category_name}</span>
          </a>
        )}

        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <time datetime={post.published_at || ''}>{formattedDate}</time>
        </span>

        <span class="inline-flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>{post.reading_time_minutes || 4}분 정독</span>
        </span>

        {post.view_count > 0 && (
          <span class="hidden sm:inline-flex items-center gap-1">
            <span>•</span>
            <span>조회 {post.view_count}</span>
          </span>
        )}
      </div>

      <!-- 포스트 요약 설명 -->
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 line-clamp-2 leading-relaxed mb-1 pr-2">
        {post.description}
      </p>
    </div>
  </div>

  <!-- Shirone 데스크톱 28% 우측 커버 썸네일 & 줌 오버레이 -->
  {post.featured_image && (
    <a
      href={`/blog/${post.slug}`}
      aria-label={post.title}
      class="group/cover max-h-48 md:max-h-none mx-0 mt-3 md:mt-0 md:w-[28%] relative md:absolute md:top-3 md:bottom-3 md:right-3 rounded-xl overflow-hidden active:scale-95 bg-neutral-100 dark:bg-slate-800 shrink-0"
    >
      <div class="absolute inset-0 pointer-events-none z-10 group-hover/cover:bg-black/30 transition-colors duration-300"></div>
      <div class="absolute inset-0 pointer-events-none z-20 flex items-center justify-center">
        <svg class="w-10 h-10 text-white opacity-0 group-hover/cover:opacity-100 scale-50 group-hover/cover:scale-100 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </div>
      <img
        src={post.featured_image}
        alt={post.title}
        class="w-full h-full object-cover group-hover/cover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </a>
  )}

  <!-- 커버 이미지가 없을 때: Shirone M3 우측 엔터 화살표 버튼 -->
  {!post.featured_image && (
    <a
      href={`/blog/${post.slug}`}
      aria-label={post.title}
      class="hidden md:flex w-12 absolute right-3 top-3 bottom-3 rounded-xl bg-[var(--primary-container)] text-[var(--on-primary-container)] hover:bg-[var(--primary)] hover:text-white active:scale-95 items-center justify-center group-hover:translate-x-0.5 transition-all"
    >
      <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  )}
</div>
<div class="transition border-t border-dashed mx-6 border-neutral-200/60 dark:border-neutral-800/80 last:border-t-0 md:hidden"></div>
