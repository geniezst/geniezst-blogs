---
import { siteConfig } from '../site.config';

interface Props {
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

// 애드센스 승인 전에는 광고 슬롯(및 'Sponsored' 플레이스홀더)을 렌더링하지 않는다.
// 실제 광고 노출은 site.config.ts 의 adsenseEnabled / adsenseClientId / 슬롯 ID 설정 시에만 활성화된다.
const { slotId = '', format = 'auto', className = '' } = Astro.props;
const clientId = siteConfig.adsenseClientId;
const enabled = Boolean(siteConfig.adsenseEnabled) && Boolean(clientId) && Boolean(slotId);
---

{enabled && (
  <div class={`ad-container my-8 mx-auto text-center overflow-hidden ${className}`}>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slotId}
      data-ad-format={format === 'auto' ? 'auto' : undefined}
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
)}
