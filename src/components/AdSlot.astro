---
interface Props {
  slotId?: string;
  format?: 'auto' | 'horizontal' | 'rectangle';
  className?: string;
}

const { slotId = 'default', format = 'auto', className = '' } = Astro.props;
---

<div class={`ad-container my-8 mx-auto text-center overflow-hidden ${className}`}>
  <!-- AdSense 코드 삽입 영역 (승인 후 활성화) -->
  <div class="p-4 border border-dashed border-gray-300 dark:border-neutral-800 rounded-lg bg-gray-50/50 dark:bg-neutral-900/50 text-xs text-gray-400 dark:text-neutral-600">
    <span>Sponsored</span>
  </div>
</div>
