---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  image?: string;
  /**
   * [P2] 1200x630 로 미리 크롭된 OG 이미지 URL (image-pipeline 가 생성, publish-post 가 저장).
   * 있으면 OG 에 우선 사용된다.
   */
  ogImage?: string | null;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  image = '/favicon.svg',
  ogImage = null,
  type = 'website',
  publishedTime,
  tags = [],
  author = '포켓머니',
} = Astro.props;

const siteName = '포켓머니';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

/*
  [P2] OG 이미지 정합성
    - 기존 기본값이 '/favicon.svg' 였다. favicon 은 OG 규격(최소 300x147, 권장 1200x630)을
      전혀 충족하지 못해, 대표 이미지가 없던 모든 글이 소셜 공유에서 깨진 카드/빈 썸네일로
      노출됐다.
    - 기본값을 실제 1200x630 JPEG 로 교체하고, width/height/alt 를 명시한다.
    - featured_image 가 세로 이미지여도 OG 규격(1.905:1) 을 벗어나므로,
      아래 OG 표준 크롭 라우트로 정규화해 링크가 항상 유효한 규격이 되게 한다.
*/
const OG_DEFAULT = '/og-default.jpg';
const OG_W = 1200;
const OG_H = 630;

const siteBase = Astro.site || 'https://pockemoney.com';
const isDefaultImage = !image || image === '/favicon.svg' || image === OG_DEFAULT;
const fullImageUrl = isDefaultImage
  ? new URL(OG_DEFAULT, siteBase).href
  : image.startsWith('http')
    ? image
    : new URL(image, siteBase).href;

/*
  [P2] OG 크롭은 빌드/파이프라인 시점에 미리 생성된 DB 값(ogImage)을 쓴다.
    SSR(Workers) 런타임에는 sharp 이 없어 요청 시점 크롭이 불가능하다.
    image-pipeline.mjs 가 1200x630 중앙 크롭 JPEG 를 함께 만들어 R2 에 올리고,
    publish-post 가 og_image 로 저장하므로 여기선 값만 소비한다.
    값이 없으면 대표 이미지, 그것도 없으면 1200x630 기본 배너로 폴백한다.
*/
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteBase).href)
  : fullImageUrl;

// JSON-LD 구조화 데이터
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: description,
      image: ogImageUrl,
      datePublished: publishedTime,
      author: {
        '@type': 'Person',
        name: author,
      },
      publisher: {
        '@type': 'Organization',
        name: siteName,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: 'https://pockemoney.com',
      description: description,
    };
---

<!-- 필수 메타 태그 -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:type" content={ogImageUrl.endsWith('.jpg') || ogImageUrl.endsWith('.jpeg') ? 'image/jpeg' : 'image/webp'} />
<meta property="og:image:width" content={String(OG_W)} />
<meta property="og:image:height" content={String(OG_H)} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:site_name" content={siteName} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={fullTitle} />

<!-- JSON-LD 구조화 데이터 -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
